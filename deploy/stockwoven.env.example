# Copie para /etc/stockwoven/stockwoven.env (dono root, grupo stockwoven, chmod 640).
# É lido pelo serviço (stockwoven.service) e pelo ./deploy.sh na hora do build. O ./deploy.sh
# cria este arquivo sozinho na primeira vez; edite depois.

# Onde o servidor Next.js escuta. O nginx aponta para cá (upstream stockwoven_app).
PORT=3100
HOSTNAME=127.0.0.1
NODE_ENV=production

# RPC de Solana usado pelo servidor (faucet). Padrão: https://api.devnet.solana.com
RPC_URL=https://api.devnet.solana.com

# RPC usado pelo navegador. Entra no JavaScript na hora do build (NEXT_PUBLIC_):
# mudar aqui exige rodar o ./deploy.sh de novo. O RPC público da devnet limita requisições;
# um RPC próprio (Helius, QuickNode...) deixa o app mais estável.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Chave do faucet: a autoridade de mint dos tokens de teste. Arquivo JSON (array de bytes),
# dono stockwoven, chmod 600. Não use uma chave que também controle o programa (veja README).
FAUCET_KEYPAIR_PATH=/etc/stockwoven/faucet-keypair.json
